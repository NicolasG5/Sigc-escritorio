<Page x:Class="WPF_LoginForm.Views.Reportes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_LoginForm.Views"
      xmlns:converters="clr-namespace:WPF_LoginForm.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="950"
      Title="Reportes">
    <Page.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>
        <converters:FirstSeguimientoObservacionesConverter x:Key="FirstSeguimientoObservacionesConverter"/>
        <converters:FirstMedicacionNombreConverter x:Key="FirstMedicacionNombreConverter"/>
    </Page.Resources>
    <Border Background="{StaticResource panelColor}" CornerRadius="10">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Grid Grid.Row="0">
                <TextBlock Text="📝 Formulario de Reporte" FontSize="28" FontWeight="Bold" Foreground="{StaticResource titleColor1}" HorizontalAlignment="Center"/>
                <Button Content="← Regresar" HorizontalAlignment="Left" Background="{StaticResource color2}" Style="{StaticResource ModernButton}" Click="Regresar" Width="120"/>
            </Grid>
            <Separator Grid.Row="1" Margin="0,15" Background="{StaticResource MediumGrayBrush}"/>
            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="👤 Información del Paciente" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Nombre Paciente:" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding Paciente.NombreCompleto}" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="Psicólogo:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbPsicologo" Style="{StaticResource ModernTextBox}" Text="{Binding Psicologo.Nombres}" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="📅 Detalles del Reporte" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Tipo de Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtTipoTratamiento" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.TipoTratamiento}" IsReadOnly="True"/>
                            <TextBlock Text="Descripción del Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtDescripcion" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.Descripcion}" Height="60" TextWrapping="Wrap" IsReadOnly="True"/>
                            <TextBlock Text="Objetivos del Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtObjetivos" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.Objetivos}" Height="60" TextWrapping="Wrap" IsReadOnly="True"/>
                            <TextBlock Text="Fecha de Inicio:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtFechaInicio" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.FechaInicio}" IsReadOnly="True"/>
                            <TextBlock Text="Fecha Fin Estimada:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtFechaFinEstimada" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.FechaFinEstimada}" IsReadOnly="True"/>
                            <TextBlock Text="Estado del Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtEstado" Style="{StaticResource ModernTextBox}" Text="{Binding Tratamiento.Estado}" IsReadOnly="True"/>
                            <TextBlock Text="Seguimiento (Observaciones):" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtSeguimiento" Style="{StaticResource ModernTextBox}" Text="{Binding Seguimientos, Converter={StaticResource FirstSeguimientoObservacionesConverter}}" Height="60" TextWrapping="Wrap" IsReadOnly="True"/>
                            <TextBlock Text="Medicaciones:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="txtMedicacion" Style="{StaticResource ModernTextBox}" Text="{Binding Medicaciones, Converter={StaticResource FirstMedicacionNombreConverter}}" Height="40" TextWrapping="Wrap" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- FOOTER CON BOTONES -->
            <Border Grid.Row="3" Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEliminar" Content="Eliminar" Background="{StaticResource ErrorBrush}" Style="{StaticResource ModernButton}" Click="Eliminar" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="BtnActualizar" Content="Actualizar" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}" Click="Actualizar" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="BtnCrear" Content="Crear" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="BtnPdf" Content="Pdf" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}" Click="Pdf" Width="100" Margin="0,0,10,0"/>
                    <Button x:Name="BtnExcel" Content="Excel" Background="{StaticResource AccentBrush}" Style="{StaticResource ModernButton}" Click="Excel" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
