<Page x:Class="WPF_LoginForm.Views.Medicacion"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:WPF_LoginForm.Views"
     mc:Ignorable="d" 
     d:DesignHeight="600" d:DesignWidth="950"
     Title="Medicacion">
    <Page.Resources>
        <!-- Modern styles from FormularioA -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>
    </Page.Resources>
    <Border Background="{StaticResource panelColor}" CornerRadius="10">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Grid Grid.Row="0">
                <TextBlock Text="💊 Formulario de Medicación" FontSize="28" FontWeight="Bold" Foreground="{StaticResource titleColor1}" HorizontalAlignment="Center"/>
                <Button Content="← Regresar" HorizontalAlignment="Left" Background="{StaticResource color2}" Style="{StaticResource ModernButton}" Click="Regresar" Width="120"/>
            </Grid>
            <Separator Grid.Row="1" Margin="0,15" Background="{StaticResource MediumGrayBrush}"/>
            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="👤 Información del Paciente" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Paciente:" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cbPaciente" SelectionChanged="cbPaciente_SelectionChanged" Height="35" FontSize="14"/>
                            <TextBlock Text="Tratamiento asociado:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbTratamiento" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="💊 Detalles de Medicación" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Nombre Medicamento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbNombreMedicamento" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Dosis:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbDosis" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Frecuencia:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbFrecuencia" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Vía de administración:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbViaAdministracion" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Fecha de inicio:" Style="{StaticResource LabelText}"/>
                            <DatePicker x:Name="dpFechaInicio" Height="35" FontSize="14"/>
                            <TextBlock Text="Fecha de fin:" Style="{StaticResource LabelText}"/>
                            <DatePicker x:Name="dpFechaFin" Height="35" FontSize="14"/>
                            <TextBlock Text="Prescrito por:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbPrescritoPor" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Observaciones:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbObservaciones" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Text="Estado:" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cbEstado" Height="35" FontSize="14" SelectedIndex="0">
                                <ComboBoxItem Content="Activo" Tag="activo"/>
                                <ComboBoxItem Content="Suspendido" Tag="suspendido"/>
                                <ComboBoxItem Content="Finalizado" Tag="finalizado"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- FOOTER CON BOTONES -->
            <Border Grid.Row="3" Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEliminar" Content="Eliminar" Background="{StaticResource ErrorBrush}" Style="{StaticResource ModernButton}" Click="Eliminar" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="BtnActualizar" Content="Actualizar" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}" Click="Actualizar" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="BtnCrear" Content="Crear" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ModernButton}" Width="130" Margin="0,0,10,0" Visibility="Hidden"/>
                    <Button x:Name="btnEnviar" Content="Guardar Medicación" Background="{StaticResource SuccessBrush}" Style="{StaticResource ModernButton}" Click="Guardar" Width="180"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
