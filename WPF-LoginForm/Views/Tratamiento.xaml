<Page x:Class="WPF_LoginForm.Views.Tratamiento"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_LoginForm.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="950"
      Title="Tratamiento">
    <Page.Resources>
        <!-- Modern styles from ConfirmarSolicitud.xaml -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource titleColor1}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>
    </Page.Resources>
    <Border Background="{StaticResource panelColor}" CornerRadius="10">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Grid Grid.Row="0">
                <TextBlock Text="📝 Formulario de Tratamiento" FontSize="28" FontWeight="Bold" Foreground="{StaticResource titleColor1}" HorizontalAlignment="Center"/>
                <Button Content="← Regresar" HorizontalAlignment="Left" Background="{StaticResource color2}" Style="{StaticResource ModernButton}" Click="Regresar" Width="120"/>
            </Grid>
            <Separator Grid.Row="1" Margin="0,15" Background="{StaticResource MediumGrayBrush}"/>
            <!-- CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="👤 Información del Paciente" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Nombre Paciente:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbNombre" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="📅 Detalles del Tratamiento" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Tipo de Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbTipoTratamiento" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Descripción:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbDescripcion" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Text="Objetivos:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbObjetivos" Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Text="Fecha Inicio:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbFechaInicio" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Fecha Fin Estimada:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbFechaFinEstimada" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Fecha Fin Real:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbFechaFinReal" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Estado:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbEstado" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="🔎 Identificadores y Registro" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ID Tratamiento:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbIdTratamiento" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="ID Paciente:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbIdPaciente" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="ID Empleado:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbIdEmpleado" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="ID Cita:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbIdCita" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="Fecha Registro:" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="tbFechaRegistro" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- FOOTER CON BOTONES -->
            <Border Grid.Row="3" Background="{StaticResource color8}" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelar" Content="Cancelar" Background="{StaticResource color10}" Style="{StaticResource ModernButton}" Click="Regresar" Width="130" Margin="0,0,10,0"/>
                    <Button x:Name="btnEnviar" Content="Guardar Tratamiento" Background="{StaticResource SuccessBrush}" Style="{StaticResource ModernButton}" Click="Guardar" Width="180"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
